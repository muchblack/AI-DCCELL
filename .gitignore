# macOS
.DS_Store

# Backup files
*.bak

# Claude Code 本地狀態
.ccb/
.claude/settings.local.json

# Gemini 本地設定（GEMINI.md 人格檔需版控）
.gemini/*
!.gemini/GEMINI.md
!.gemini/skills/

# 執行時資料（不版控，每台機器不同）
logs/
data/

# Telemetry（運行時產生）
skills/memory/telemetry.jsonl

# Python virtualenv（每台機器自建，勿入庫）
**/.venv/
**/__pycache__/

# claude.ai 同步進來的內建 skills（每台機器各自產生）
claude/skills/synced/

# Windows 下載附帶的 ADS 檔
*:Zone.Identifier
